# Server Port
PORT=5000
NODE_ENV=development

# Coordinator / Default Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders_coordinator

# Database Shards Configuration (PostgreSQL)
SHARD_1_URL=postgresql://postgres:your_password@localhost:5433/orders_shard1
SHARD_2_URL=postgresql://postgres:your_password@localhost:5434/orders_shard2
SHARD_3_URL=postgresql://postgres:your_password@localhost:5435/orders_shard3
SHARD_4_URL=postgresql://postgres:your_password@localhost:5436/orders_shard4

# Redis Configuration (BullMQ / ioredis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google Cloud Storage Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_FILE=path/to/keyfile.json
GCP_BUCKET_NAME=your-gcs-bucket-name
